{
  "_version": "2.0",
  "_description": "Dynamic mapping from Wazuh rule.groups and mitre.tactic to 22 Sweet Spot Categories. Loaded at pipeline startup for maximum extensibility without code modifications.",
  "canonical_categories": [
    "RANSOMWARE",
    "MALWARE",
    "COMMAND_AND_CONTROL",
    "EXFILTRATION",
    "LATERAL_MOVEMENT",
    "PRIVILEGE_ESCALATION",
    "CREDENTIAL_ACCESS",
    "DEFENSE_EVASION",
    "EXECUTION",
    "PERSISTENCE",
    "DISCOVERY",
    "INITIAL_ACCESS",
    "AUTH_FAILURE",
    "AUTH_SUCCESS",
    "WEB_ATTACK",
    "WEB_OPERATIONAL",
    "FILE_INTEGRITY",
    "VULNERABILITY",
    "CONFIGURATION_ASSESSMENT",
    "CLOUD_CONTAINER",
    "SYSTEM_HEALTH",
    "OTHER"
  ],
  "precedence_order": [
    "RANSOMWARE",
    "MALWARE",
    "COMMAND_AND_CONTROL",
    "EXFILTRATION",
    "LATERAL_MOVEMENT",
    "PRIVILEGE_ESCALATION",
    "CREDENTIAL_ACCESS",
    "DEFENSE_EVASION",
    "EXECUTION",
    "PERSISTENCE",
    "DISCOVERY",
    "INITIAL_ACCESS",
    "AUTH_FAILURE",
    "AUTH_SUCCESS",
    "WEB_ATTACK",
    "WEB_OPERATIONAL",
    "FILE_INTEGRITY",
    "VULNERABILITY",
    "CONFIGURATION_ASSESSMENT",
    "CLOUD_CONTAINER"
  ],
  "tier1_group_rules": [
    {
      "category": "RANSOMWARE",
      "groups": ["ransomware", "vssadmin", "shadow_copy", "backup_tamper", "encryption"],
      "tactics": ["impact"],
      "tactic_require_groups": ["defense_evasion", "log_clear", "file_tampering"],
      "default_actor_prefix": "proc:ransomware",
      "window_class": "FAST",
      "window_seconds": 300
    },
    {
      "category": "MALWARE",
      "groups": ["malware", "virus", "trojan", "rootcheck", "yara", "rootkit"],
      "default_actor": "rootcheck",
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "COMMAND_AND_CONTROL",
      "groups": ["c2", "command_and_control", "dns_tunnel", "beacon"],
      "tactics": ["command and control", "command_and_control"],
      "default_actor_prefix": "proc:c2_agent",
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "EXFILTRATION",
      "groups": ["exfiltration", "data_theft", "dns_exfil"],
      "tactics": ["exfiltration"],
      "default_actor_prefix": "proc:exfil_agent",
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "LATERAL_MOVEMENT",
      "groups": ["lateral_movement", "admin_share", "wmi_exec", "psexec", "rdp_pivot"],
      "tactics": ["lateral movement", "lateral_movement"],
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "PRIVILEGE_ESCALATION",
      "groups": ["privilege_escalation", "sudo", "setuid", "uac_bypass", "token_manipulation"],
      "tactics": ["privilege escalation", "privilege_escalation"],
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "CREDENTIAL_ACCESS",
      "groups": ["credential_access", "credential_dump", "kerberoast", "brute_force", "password_spray"],
      "tactics": ["credential access", "credential_access"],
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "DEFENSE_EVASION",
      "groups": ["defense_evasion", "log_clear", "timestomp", "amsi_bypass", "antivirus_disabled"],
      "tactics": ["defense evasion", "defense_evasion"],
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "EXECUTION",
      "groups": ["execution", "powershell", "script", "wscript", "command_line", "encoded_command"],
      "tactics": ["execution"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "PERSISTENCE",
      "groups": ["persistence", "cron", "scheduled_task", "registry_run", "startup", "webshell"],
      "tactics": ["persistence"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "DISCOVERY",
      "groups": ["discovery", "recon", "network_scan", "port_scan", "enumeration"],
      "tactics": ["discovery", "reconnaissance"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "INITIAL_ACCESS",
      "groups": ["initial_access", "exploit", "supply_chain", "drive_by"],
      "tactics": ["initial access", "initial_access"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "AUTH_FAILURE",
      "groups": ["authentication_failed", "authentication_failures", "invalid_login", "login_failed"],
      "window_class": "FAST",
      "window_seconds": 600
    },
    {
      "category": "AUTH_SUCCESS",
      "groups": ["authentication_success", "login_success", "session_opened", "session_open"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "WEB_ATTACK",
      "groups": ["web_attack", "sqli", "xss", "rfi", "lfi", "web_exploit", "attack"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "WEB_OPERATIONAL",
      "groups": ["web", "apache", "nginx", "httpd", "access_denied", "web_error"],
      "window_class": "STANDARD",
      "window_seconds": 900
    },
    {
      "category": "FILE_INTEGRITY",
      "groups": ["syscheck", "integrity", "checksum", "fim", "file_added", "file_modified"],
      "window_class": "SLOW",
      "window_seconds": 1800
    },
    {
      "category": "VULNERABILITY",
      "groups": ["vulnerability-detector", "vulnerability", "cve"],
      "window_class": "SLOW",
      "window_seconds": 3600
    },
    {
      "category": "CONFIGURATION_ASSESSMENT",
      "groups": ["sca", "cis", "configuration_assessment", "policy"],
      "window_class": "SLOW",
      "window_seconds": 3600
    },
    {
      "category": "CLOUD_CONTAINER",
      "groups": ["docker", "kubernetes", "container", "cloud", "aws", "azure", "gcp"],
      "window_class": "STANDARD",
      "window_seconds": 900
    }
  ]
}
