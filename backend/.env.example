# ==============================================================================
# Wazuh SOC Intelligence Platform - Environment Configuration Template
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wazuh_soc_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MINCONN=2
DB_MAXCONN=30

# API Security & Hardening
SOC_API_KEY=wazuh-soc-secure-key-2026
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development

# Pipeline Window Settings
CHUNK_SIZE=10000
DEDUP_WINDOW_SECONDS=900
CORRELATION_WINDOW_SECONDS=1800
LOW_AND_SLOW_THRESHOLD=15
LOW_AND_SLOW_WINDOW_HOURS=6

# State Persistence Directory
PERSISTENCE_DIR=config/state
