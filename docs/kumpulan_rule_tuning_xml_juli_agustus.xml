    <group>compliance_alert,sca_score_critical,priority_p2,</group>
  </rule>

  <!-- 6.11 Elevasi TP: Terputusnya Agen Wazuh Tidak Terencana pada Node Produksi -->
  <rule id="108564" level="9">
    <if_sid>504</if_sid>
    <description>TP-ELEVATION: Unexpected disconnection of Wazuh agent monitoring production host</description>
    <group>agent_health,unexpected_disconnect,priority_p2,</group>
  </rule>


  <!-- ============================================================================
       DOMAIN 7: MULTI-STAGE ATTACK CHAINS & CORRELATION SEQUENCES
       ============================================================================ -->

  <!-- 7.1 Korelasi Attack Chain: Brute Force SSH Diikuti oleh Login Sukses dari IP yang Sama -->
  <rule id="107101" level="13" frequency="1" timeframe="900">
    <if_sid>108530, 108531, 5710, 5712, 5760</if_sid>
    <if_matched_sid>5715</if_matched_sid>
    <same_source_ip />
    <description>ATTACK-CHAIN: Successful SSH authentication following brute force attacks from identical source IP</description>
    <group>attack_chain,credential_compromise,priority_p0,</group>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- 7.2 Korelasi Attack Chain: Login Eksternal Sukses Diikuti oleh Eskalasi Hak Akses Root (Sudo) -->
  <rule id="107102" level="14" frequency="1" timeframe="600">
    <if_sid>107101, 5715</if_sid>
    <if_matched_sid>5402, 5403, 108532</if_matched_sid>
    <same_agent />
    <description>ATTACK-CHAIN: Privilege escalation to ROOT executed on host immediately following external authentication</description>
    <group>attack_chain,root_compromise,priority_p0,</group>
    <mitre>
      <id>T1078</id>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- 7.3 Korelasi Attack Chain: Pemindaian Celah Web Diikuti oleh Akses Webshell atau HTTP 500 -->
